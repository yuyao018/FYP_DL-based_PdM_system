# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Notification Configuration (Gmail SMTP)
# Use a Gmail App Password — NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
EMAIL_SENDER=yourname@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
DASHBOARD_URL=https://your-app.onrender.com

# Groq API (LLM for Degradation Analysis explanations — free tier)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
